<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /TempFan/
    
    # Allow real files and directories to pass through
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Rewrite all other requests to index.php
    RewriteRule ^ index.php [L]
</IfModule>
